{
  "name": "scroll-bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "demo": "vite build && vite preview --host 127.0.0.1 --port 4173 --open /demo.html",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test --test-concurrency=1 tests/browser/*.test.mjs",
    "bench": "node scripts/bench.mjs",
    "bench:publish": "node scripts/bench-publish.mjs",
    "bench:install": "playwright install chromium firefox webkit"
  },
  "dependencies": {
    "@tanstack/react-virtual": "3.14.18",
    "ag-grid-community": "36.2.0",
    "ag-grid-react": "36.2.0",
    "rc-virtual-list": "3.19.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-virtualized": "9.22.6",
    "react-virtuoso": "4.18.19",
    "react-window": "2.3.4",
    "virtua": "0.53.5"
  },
  "devDependencies": {
    "playwright": "1.61.1",
    "vite": "6.4.4"
  }
}
